# Copy to .env and fill in. Never commit .env.

# OpenAI API key (https://platform.openai.com/api-keys).
# Needed for the agent, the `ask` command and the LLM-judged evaluations.
# Retrieval, tests and the free evaluations work without it.
OPENAI_API_KEY=

# Optional model overrides. Leave empty to use the defaults in copilot/config.py.
OPENAI_MODEL=
OPENAI_EVAL_MODEL=
