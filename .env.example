# Copy to .env and fill in. Never commit .env.

# OpenAI API key (https://platform.openai.com/api-keys).
# Needed for the agent, the `ask` command and the LLM-judged evaluations.
# Retrieval, tests and the free evaluations work without it.
OPENAI_API_KEY=

# Optional model overrides. Leave empty to use the defaults in src/copilot/config.py.
OPENAI_MODEL=
OPENAI_EVAL_MODEL=

# Optional: protect /query and /search when the API is exposed beyond your machine.
# Comma-separated keys; clients send one in the X-API-Key header. Leave empty for local use.
COPILOT_API_KEYS=

# Optional: total /query requests allowed per UTC day, to cap LLM spend on a public deployment.
# About $0.0014 per question with gpt-5.6-luna, so 50 a day is about $0.07. Leave empty for no limit.
COPILOT_QUERY_DAILY_LIMIT=

# Optional: token prices (USD per million tokens) to estimate cost per question in logs,
# API responses and eval summaries. Take them from the provider's pricing page.
COPILOT_PRICE_INPUT_PER_MTOK=
COPILOT_PRICE_OUTPUT_PER_MTOK=
